# Copy to .env (or run `make env`, which generates random values). Never commit .env.
# All values below are placeholders; `make env` replaces the secrets with random strings.

# PostgreSQL superuser (init only)
POSTGRES_SUPERUSER_PASSWORD=change-me
# Owner role: migrations only (never used by the running API)
MFOP_OWNER_PASSWORD=change-me
# Runtime role used by the API: SELECT/INSERT/UPDATE, no DELETE
MFOP_APP_PASSWORD=change-me
# Read-only role for auditor tooling (audit-verify)
MFOP_READONLY_PASSWORD=change-me
# Keycloak's own database user
KEYCLOAK_DB_PASSWORD=change-me
# Keycloak bootstrap admin console user "kcadmin" (http://localhost:8080/admin)
KEYCLOAK_ADMIN_PASSWORD=change-me
# Server secret for QR tag check codes (rejects tag codes invented outside the system)
MFOP_TAG_CHECK_KEY=change-me
# Keycloak client secret of the API's service account "mfop-backend" (offboarding: disable user, end sessions). M4.
MFOP_KEYCLOAK_BACKEND_SECRET=change-me
# Offline-grant signing key: EC P-256 private key, PKCS#8 DER, base64 on one line (`make env` generates one). M4.
MFOP_GRANT_SIGNING_KEY=change-me
# Password for ALL synthetic dev users (min 12 chars, Keycloak policy). DEV ONLY.
MFOP_DEV_USER_PASSWORD=change-me-12chars

# Host ports (Keycloak must stay on 8080: the dev realm redirect/issuer URLs use it)
WEB_PORT=5173
API_PORT=5080
DB_PORT=5432
